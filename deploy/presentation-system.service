[Unit]
Description=Presentation System (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/presentation-system
ExecStart=/root/.bun/bin/bun run start
KillSignal=SIGINT
TimeoutStopSec=15
Restart=always
RestartSec=5

EnvironmentFile=/var/www/presentation-system/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
